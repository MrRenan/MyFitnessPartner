# Build artifacts — exclui tudo de build/ EXCETO o JAR executável,
# que o CI compila e o Dockerfile precisa copiar.
build/*
!build/libs
build/libs/*
!build/libs/*.jar
.gradle/
out/
bin/

# IDE
.idea/
.vscode/
*.iml

# Git
.git/
.gitignore
.gitattributes

# Secrets e configs locais — NUNCA entram na imagem
.env
.env.*
!.env.prod.example
src/main/resources/application-dev.yml

# Docs e artefatos de agente
.agents/
*.md
HELP.md

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
