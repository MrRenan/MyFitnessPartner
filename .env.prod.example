# ─────────────────────────────────────────────────────────
# Variáveis de ambiente de PRODUÇÃO
# Copie este arquivo para `.env` e preencha com valores reais.
# NUNCA comite o arquivo `.env` com valores reais.
#
#   cp .env.prod.example .env
# ─────────────────────────────────────────────────────────

# ── Banco de dados (PostgreSQL) ──
POSTGRES_DB=myfitnesspartner
POSTGRES_USER=myfitness
# Use uma senha forte e única em produção
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ── IA (Google Gemini via Spring AI) ──
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-do-gemini-aqui
GEMINI_MODEL=gemini-2.5-flash

# ── JWT ──
# Deve ter pelo menos 256 bits (32+ caracteres). Gere uma string aleatória.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
